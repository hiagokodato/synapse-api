# Synapse API — copiar para .env
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon: use pooled URL (-pooler) for the app; direct URL (no -pooler) if migrate fails

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Chave para criptografar os tokens das integrações (Telegram/WhatsApp) no banco — mín. 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=change-me-credentials-key-min-32-chars

# Documentação Swagger em /docs (padrão: ligada fora de produção, desligada em produção)
# SWAGGER_ENABLED=false
